<h1><%= @book.title %></h1>
<p><%= @book.author %></p>
<p><%= @book.description %></p>
<p><%= @book.status %></p>

<%= link_to "Edit", edit_book_path(@book) %>
<%= link_to "Back to Shelf", books_path %>

<hr>

<h2>Reviews</h2>

<% @book.reviews.each do |review| %>
  <div>
    <p>Rating: <%= review.rating %>/5</p>
    <p><%= review.content %></p>
    <% if review.user == current_user %>
      <%= link_to "Delete", book_review_path(@book, review), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    <% end %>
  </div>
<% end %>

<hr>

<h2>Write a Review</h2>

<%= form_with model: [@book, Review.new], url: book_reviews_path(@book) do |f| %>
  <div>
    <%= f.label :rating %>
    <%= f.number_field :rating, min: 1, max: 5 %>
  </div>
  <div>
    <%= f.label :content %>
    <%= f.text_area :content %>
  </div>
  <%= f.submit "Submit Review" %>
<% end %>